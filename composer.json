{
    "name": "deapi/ai-provider-for-deapi",
    "description": "deAPI provider for the PHP AI Client SDK. Works as both a Composer package and WordPress plugin.",
    "license": "GPL-2.0-or-later",
    "keywords": ["ai", "deapi", "wordpress", "image-generation", "text-to-speech", "embeddings"],
    "authors": [
        {
            "name": "deAPI",
            "homepage": "https://deapi.ai"
        }
    ],
    "homepage": "https://github.com/deapi-ai/ai-provider-for-deapi",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "wordpress/php-ai-client": "^1.5"
    },
    "suggest": {
        "wordpress/php-ai-client": "Required. The PHP AI Client SDK that this provider extends."
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "DeApi\\AiProvider\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeApi\\AiProvider\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "7.4"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
